# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit .env or paste these keys in chat.

PORT=8000

# Public HTTPS URL of your tunnel (cloudflared / ngrok) WITHOUT a trailing slash.
# Agora's cloud agent calls  PUBLIC_URL/api/brain/chat/completions
# Example: https://something-random.trycloudflare.com
PUBLIC_URL=

# ---- Agora (console.agora.io) ----
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Account menu -> RESTful API -> add a key. Used to start/stop the AI agent.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Language(s) the agent listens for. Examples: en-US, en-IN, hi-IN, kn-IN, ta-IN
# Several: "en-IN,hi-IN"  (ask mentors which ones the default ASR supports)
ASR_LANGUAGE=en-IN

# ---- Murf (murf.ai API dashboard) ----
MURF_API_KEY=
# Voice ID from the hackathon's "Recommended Indian voices" sheet
MURF_VOICE_ID=
MURF_LOCALE=en-IN

# ---- LLM (must support tool calling + images) ----
# Gemini (default): key from aistudio.google.com
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
# If a call takes longer than this, retry once (on LLM_FALLBACK_MODEL if set)
LLM_TIMEOUT_MS=5000
LLM_FALLBACK_MODEL=
# For OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Shared secret Agora sends to our brain endpoint (any random string)
BRAIN_SECRET=change-me-to-something-random

# ---- Live web prices for items not in catalog.json ----
# Free key at serper.dev (2,500 searches, no card). Leave empty to use only the catalog.
SERPER_API_KEY=

# ---- Groq (fast brain, tried first; Gemini above is the backup) ----
# Free key: console.groq.com -> API Keys
GROQ_API_KEY=
# Comma-separated, tried in order (each model has its own free rate limit)
GROQ_BRAIN_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_VISION_MODELS=qwen/qwen3.8-27b
